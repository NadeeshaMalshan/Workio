# ==========================================
# SuperBass - .gitignore for .NET & React
# ==========================================

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.pfx

# ------------------------------------------
# Python & Logs
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.log
*.egg-info/
.venv/
.pytest_cache/
.vscode/
# ------------------------------------------
# React / Node / Vite / Webpack
# ------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.eslintcache
.stylelintcache
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# .NET / C# / ASP.NET Core
# ------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio & IDEs
.vs/
.idea/
*.sln.docstates
*.suo
*.user
*.userosscache
*.userprefs
*.rsuser
*.DotSettings.user

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# NuGet Packages & Lock Files
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# ASP.NET Scaffolding & Publish
ScaffoldingReadMe.txt
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# Database local files
*.mdf
*.ldf
*.ndf

# ------------------------------------------
# OS / System Temporary Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.lnk

# Linux / Editor Swap Files
*.swp
*~
*.tmp
/App/linux/flutter
*.h
*.yaml
App/linux/flutter/generated_plugin_registrant.cc
App/linux/flutter/generated_plugin_registrant.h
App/linux/flutter/generated_plugins.cmake
App/macos/Flutter/GeneratedPluginRegistrant.swift
App/pubspec.lock
App/windows/flutter/generated_plugin_registrant.cc
App/windows/flutter/generated_plugin_registrant.h
App/windows/flutter/generated_plugins.cmake
App/linux/flutter/generated_plugin_registrant.cc
App/linux/flutter/generated_plugin_registrant.cc
App/linux/flutter/generated_plugins.cmake
App/macos/Flutter/GeneratedPluginRegistrant.swift
App/pubspec.lock
App/windows/flutter/generated_plugin_registrant.cc
App/windows/flutter/generated_plugin_registrant.h
App/windows/flutter/generated_plugins.cmake
Frontend/package-lock.json
/App/test

/Backend/tests
